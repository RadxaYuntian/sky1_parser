#!/usr/bin/env bash

set -euo pipefail
shopt -s nullglob

echo "存储设备检测中……"
MEMTEST_DISK="${1:-/dev/sda}"

if [[ ! -b "$MEMTEST_DISK" ]]; then
    echo "错误: $MEMTEST_DISK 是无效的存储设备。" >&2
    exit 1
fi


if [[ ! -b "${MEMTEST_DISK}1" ]] || [[ ! -b "${MEMTEST_DISK}2" ]] || [[ ! -b "${MEMTEST_DISK}3" ]]; then
    echo "警告: $MEMTEST_DISK 可能不是合法的 MemTest86 磁盘。" >&2
fi

__mount() {
    local block_device="$1" mount_point
    if command -v udisksctl &>/dev/null; then
        if mount_point="$(LC_ALL=C udisksctl mount --no-user-interaction -b "$block_device" | cut -f 4 -d " ")"; then
            echo "$mount_point"
            return
        else
            echo "警告: udisksctl 挂载失败。尝试提权后重新挂载。" >&2
        fi
    fi
    if command -v mount &>/dev/null; then
        mount_point="$(mktemp -d)"
        if sudo mount "$block_device" "$mount_point" &>/dev/null; then
            echo "$mount_point"
        else
            echo "错误: 无法挂载分区 $block_device。" >&2
            return 1
        fi
    else
        echo "错误: 无法挂载分区。请安装 udisksctl 或 mount。" >&2
        return 1
    fi
}

__mv() {
    if ! mv "$@"; then
        echo "警告: 移动失败。尝试提权后重新移动。" >&2
        sudo mv "$@"
    fi
}

__unmount() {
    local mount_point="$1"
    if command -v udisksctl &>/dev/null; then
        if udisksctl unmount --no-user-interaction -b "$mount_point" &>/dev/null; then
            return
        else
            echo "警告: udisksctl 卸载失败。尝试提权后重新卸载。" >&2
        fi
    fi
    if command -v umount &>/dev/null; then
        if ! sudo umount "$mount_point" &>/dev/null; then
            echo "错误: 无法卸载分区 $mount_point。" >&2
            return 1
        fi
    else
        echo "错误: 无法卸载分区。请安装 udisksctl 或 umount。" >&2
        return 1
    fi
}

echo "存储设备挂载中……"
MEMTEST_PARTITION="${MEMTEST_DISK}1"
MOUNT_POINT=
if ! MOUNT_POINT="$(__mount "$MEMTEST_PARTITION")"; then
    exit 1
fi
trap "__unmount "$MEMTEST_PARTITION"" SIGINT SIGQUIT SIGTSTP EXIT

echo "日志文件检测中……"
LOG_EXIST_FLAG=false
for i in "$MOUNT_POINT"/EFI/BOOT/*.log; do
    if [[ -f "$i" ]]; then
        echo "检测到日志文件: $i"
        LOG_EXIST_FLAG=true
    fi
done

if ! $LOG_EXIST_FLAG; then
    echo "错误: 未检测到日志文件。请确保 MemTest86 已运行并生成日志。" >&2
    exit 1
fi

echo "日志文件保存中……"
SCRIPT_DIR="$(dirname $(realpath "$0"))"
LOG_DIR="${LOG_DIR:-$SCRIPT_DIR/logs}"
CURRENT_LOG_DIR="$LOG_DIR/$(date -Iseconds)"
mkdir -p "$CURRENT_LOG_DIR"
if ! __mv "$MOUNT_POINT"/EFI/BOOT/*.log "$CURRENT_LOG_DIR"; then
    echo "错误: 无法移动日志文件。" >&2
    exit 1
fi
__unmount "$MEMTEST_PARTITION"
trap - SIGINT SIGQUIT SIGTSTP EXIT

echo "日志文件分析中……"
MEM_CHANNEL=()
while read -r; do
    MEM_CHIP=
    MEM_CHIP="$($SCRIPT_DIR/get_channel_id "0x$REPLY")"
    MEM_CHANNEL["$MEM_CHIP"]="$MEM_CHIP"
done < <(grep -h 'MEM ERROR - Data' "$CURRENT_LOG_DIR"/*.log | cut -d ' ' -f 13 | tr -d ",")

if (( ${#MEM_CHANNEL[@]} == 0 )); then
    echo "日志没有检测到内存错误。"
else
    echo "以下${#MEM_CHANNEL[@]}块芯片[范围：0-3]检测出内存问题：" "${MEM_CHANNEL[@]}"
fi
