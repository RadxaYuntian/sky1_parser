#!/usr/bin/env bash

set -euo pipefail
shopt -s nullglob

SCRIPT_DIR="$(dirname $(realpath "$0"))"

MEM_CHANNEL=()
while read -r; do
    MEM_CHIP=
    if ! MEM_CHIP="$($SCRIPT_DIR/get_channel_id "0x$(cut -d ' ' -f 13 <<< "$REPLY" | tr -d ",")" 2>/dev/null)"; then
        echo "错误: 无法解析的日志: $REPLY" >&2
        continue
    fi
    MEM_CHANNEL["$MEM_CHIP"]="$MEM_CHIP"
done < <(grep --text -h 'MEM ERROR - Data' "$@")

BOOT_COUNT=0
if ! BOOT_COUNT=$(grep --text -h "Attempting to retrieve the root directory of the data partition." "$@" | wc -l); then
    echo "日志中未检测到 MemTest86 启动。"
    exit 1
fi

if (( ${#MEM_CHANNEL[@]} == 0 )); then
    echo "启动次数: $BOOT_COUNT。日志没有检测到内存错误。"
else
    echo "启动次数: $BOOT_COUNT。以下${#MEM_CHANNEL[@]}块芯片[范围：0-3]检测出内存问题：" "${MEM_CHANNEL[@]}"
fi
